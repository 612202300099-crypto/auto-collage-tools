# ═══════════════════════════════════════════════════════════════
#  AutoCollage A3+ — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ─── Frontend (Vercel / AI Studio) ────────────────────────────

# Gemini API Key (optional, for AI Studio integration)
GEMINI_API_KEY=""

# App URL (auto-injected by AI Studio / Vercel)
APP_URL=""

# Google OAuth (for Vercel serverless deployment)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI API Key (for Premium face detection via /api/detect-face)
OPENAI_API_KEY=""

# ─── Worker: Google Drive ─────────────────────────────────────

# Root PESANAN folder ID (contains all shop folders)
# Get from URL: https://drive.google.com/drive/folders/<THIS_ID>
DRIVE_ROOT_FOLDER_ID="19jxzRfZ826Exw_nlk1k2wAH_7u1Hmcxl"

# Secondary Drive folder for uploading finished PDFs
SECONDARY_DRIVE_FOLDER_ID=""

# ─── Worker: Multi-Shop Configuration ────────────────────────
# JSON array of shops. Each shop needs:
#   - name: exact folder name in Google Drive
#   - spreadsheetId: Google Spreadsheet ID for this shop
#   - sheetName: (optional) default "FOTO POLAROID"
#   - polaroidFolderName: (optional) default "POLAROID"
#
# The EDITOR column is auto-detected from the spreadsheet header.
SHOPS='[{"name":"CUSTOMBASE","spreadsheetId":"1etNKBpSMcyranW1YbtDdI3KiSSRphaXOREQEnXaftY0"},{"name":"GIFTYOURS","spreadsheetId":"1xZyKPgqf7A5cOSQH2dTK5jMcd87G-oErsoc5k5pIa80"},{"name":"VENTURA","spreadsheetId":"1boeBFowYE_F3Nk78mU6HmlSLp5w1HALhNQuyEMibTLU"}]'

# ─── Worker: Editor ───────────────────────────────────────────

# Text written to the column after EDITOR (configurable via dashboard)
# Example: "sen 3", "bot session 1", "shift malam"
EDITOR_TEXT=""

# ─── Worker: General Settings ─────────────────────────────────

# Polling interval in minutes (1–60)
POLL_INTERVAL_MINUTES=5

# Max concurrent jobs (1–20)
MAX_CONCURRENCY=5

# Worker dashboard port
WORKER_PORT=4000

# Enable face detection on server-side (true/false)
ENABLE_FACE_DETECTION=true

# Dry run mode — no uploads or writes (true/false)
DRY_RUN=false

# OAuth credentials paths (defaults to ./credentials/)
# GOOGLE_CREDENTIALS_PATH="./credentials/credentials.json"
# GOOGLE_TOKEN_PATH="./credentials/token.json"
