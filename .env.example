# ═══════════════════════════════════════════════════════════════
#  AutoCollage A3+ — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# ─── Frontend (Vercel / AI Studio) ────────────────────────────

# Gemini API Key (optional, for AI Studio integration)
GEMINI_API_KEY=""

# App URL (auto-injected by AI Studio / Vercel)
APP_URL=""

# Google OAuth (for Vercel serverless deployment)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI API Key (for Premium face detection via /api/detect-face)
OPENAI_API_KEY=""

# ─── Worker Automation ────────────────────────────────────────

# Google Drive root folder ID (contains date folders)
# Get from URL: https://drive.google.com/drive/folders/<THIS_ID>
DRIVE_ROOT_FOLDER_ID=""

# Google Spreadsheet ID
# Get from URL: https://docs.google.com/spreadsheets/d/<THIS_ID>
SPREADSHEET_ID=""

# Sheet names in the spreadsheet
SHEET_NAME="FOTO POLAROID"
EKSPORT_SHEET_NAME="EKSPORT"

# Polling interval in minutes (1–60)
POLL_INTERVAL_MINUTES=5

# Max concurrent jobs (1–20)
MAX_CONCURRENCY=5

# Worker dashboard port
WORKER_PORT=4000

# Enable face detection on server-side (true/false)
ENABLE_FACE_DETECTION=true

# Dry run mode — no uploads or writes (true/false)
DRY_RUN=false

# Optional: Secondary Google Drive folder for backup uploads
# SECONDARY_DRIVE_FOLDER_ID=""

# Optional: Target specific date folder (DD-MM-YYYY or ALL)
# TARGET_DATE_FILTER="ALL"

# OAuth credentials paths (defaults to ./credentials/)
# GOOGLE_CREDENTIALS_PATH="./credentials/credentials.json"
# GOOGLE_TOKEN_PATH="./credentials/token.json"
